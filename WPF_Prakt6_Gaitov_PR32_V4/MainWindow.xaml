<Window x:Class="WPF_Prakt6_Gaitov_PR32_V4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Prakt6_Gaitov_PR32_V4"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="475" Style="{DynamicResource BackGround}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="images.jpg" Stretch="Fill"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Text="Робот-пылесос" Style="{DynamicResource ProductName}"/>
            <TextBlock Grid.Column="1" Grid.Row="0" Text="4899 руб." Style="{DynamicResource ProductPrice}"/>

            <ProgressBar Grid.Column="0" Grid.Row="1" Value="70" Maximum="100"/>
            <Label Grid.Column="1" Grid.Row="1" Content="До скидки" Style="{DynamicResource PriceLabel}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <CheckBox Grid.Column="0" Grid.Row="0"/>
            <Label Grid.Column="1" Grid.Row="0" Content="Страховка" Style="{DynamicResource SectionLabel}"/>

            <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Vertical">
                <Label Style="{DynamicResource SectionLabel}" Content="Город"/>
                <TextBox Style="{DynamicResource TextBox}"/>
            </StackPanel>

            <CheckBox Grid.Column="0" Grid.Row="1"/>
            <Label Grid.Column="1" Grid.Row="1" Content="Рассрочка" Style="{DynamicResource SectionLabel}"/>

            <RadioButton Grid.Column="0" Grid.Row="2" GroupName="Delivery"/>
            <Button IsEnabled="False" Content="Узнать более" Grid.Row="1" Grid.Column="2" Style="{DynamicResource InfoButton}"/>

            <Label Grid.Column="1" Grid.Row="2" Content="Самвывоз       Доставка         До двери" Margin="0, 10" Style="{StaticResource SectionLabel}"/>

            <RadioButton Grid.Column="2" Grid.Row="2" GroupName="Delivery"/>

            <Label Content="Цвет:" Grid.Column="0" Grid.Row="3" Style="{DynamicResource SectionLabel}"/>
            <ComboBox Grid.Column="1" Grid.Row="3">
                <ComboBoxItem Content="Черный"/>
                <ComboBoxItem Content="Белый"/>
            </ComboBox>
            
            <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Vertical">
                <Label  Style="{DynamicResource SectionLabel}" Content="Комментарий к заказу"/>
                <TextBox Style="{DynamicResource MultiLineTextBox}"/>
            </StackPanel>

            <Button Content="Купить" Grid.Column="0" Grid.Row="5" Style="{DynamicResource BuyButton}"/>
            <Button Click="ChangeThemeButton_Click" Content="Тема" Grid.Column="1" Grid.Row="5" Style="{DynamicResource ThemeSwitch}"/>
            <Button Content="Отмена" Grid.Column="2" Grid.Row="5" Style="{DynamicResource CancelButton}"/>
        </Grid>
    </Grid>
</Window>